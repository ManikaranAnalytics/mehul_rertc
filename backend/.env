# ─────────────────────────────────────────────────────────────────────────────
# RE-RTC Dispatch Optimizer — Environment Variables
# Loaded automatically on startup (python-dotenv).
# ─────────────────────────────────────────────────────────────────────────────

PORT=9000
FRONTEND_PORT=8012
WEB_CONCURRENCY=2
ALLOWED_ORIGINS=*

# ── PostgreSQL (remote) ───────────────────────────────────────────────────────
POSTGRES_HOST=13.235.110.27
POSTGRES_PORT=5432
POSTGRES_USER=rertc
POSTGRES_PASSWORD=Rertc@1212
POSTGRES_DB=rertc
DATABASE_URL=postgresql+psycopg://rertc:Rertc%401212@13.235.110.27:5432/rertc

# ── Docker frontend proxy ─────────────────────────────────────────────────────
BACKEND_UPSTREAM=http://host.docker.internal:9000
# Bind backend to localhost only when frontend also uses :8012 (default for deploy)
BACKEND_BIND=127.0.0.1

# Local dev (uncomment to use Mac Postgres instead of remote)
# DATABASE_URL=postgresql+psycopg://re_rtc@localhost:5432/re_rtc

DEV_RELOAD=true
SERVE_FRONTEND=false

# ── Admin module ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_EXPIRE_HOURS=12
