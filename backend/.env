# ─────────────────────────────────────────────────────────────────────────────
# RE-RTC Dispatch Optimizer — Environment Variables
# Loaded automatically on startup (python-dotenv).
# ─────────────────────────────────────────────────────────────────────────────

PORT=8012
WEB_CONCURRENCY=2
ALLOWED_ORIGINS=*

# Docker: bind on all interfaces so direct IP works (no nginx)
BACKEND_BIND=0.0.0.0
# Local uvicorn dev — keep false; Docker compose sets SERVE_FRONTEND=true
SERVE_FRONTEND=false

# ── PostgreSQL (remote, same host as Docker app) ───────────────────────────────
# Use host.docker.internal when DB runs on the same VPS as the backend container.
# Use the public IP only when DB is on a different server.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=rertc
POSTGRES_PASSWORD=Rertc@1212
POSTGRES_DB=rertc
DATABASE_URL=postgresql+psycopg://rertc:Rertc%401212@host.docker.internal:5432/rertc

# Local dev (uncomment to use Mac Postgres instead of remote)
# DATABASE_URL=postgresql+psycopg://re_rtc@localhost:5432/re_rtc

DEV_RELOAD=false

# ── Admin module ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_EXPIRE_HOURS=12
