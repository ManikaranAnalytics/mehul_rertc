# ─────────────────────────────────────────────────────────────────────────────
# RE-RTC Dispatch Optimizer — Environment Variables
# Loaded automatically on startup (python-dotenv).
# Cloud deploy: git pull && bash deploy.sh  →  http://<host>:8012
# ─────────────────────────────────────────────────────────────────────────────

PORT=8012
WEB_CONCURRENCY=2
ALLOWED_ORIGINS=*

# Docker: bind on all interfaces so direct IP works (no nginx)
BACKEND_BIND=0.0.0.0
# Docker compose overrides this to true; keep false for local uvicorn dev only
SERVE_FRONTEND=false

# ── PostgreSQL (same VPS as Docker app) ───────────────────────────────────────
# host.docker.internal reaches Postgres on the host (see extra_hosts in compose)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=rertc
POSTGRES_PASSWORD=Rertc@1212
POSTGRES_DB=rertc
DATABASE_URL=postgresql+psycopg://rertc:Rertc%401212@host.docker.internal:5432/rertc

DEV_RELOAD=false

# ── Admin module ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_EXPIRE_HOURS=12
