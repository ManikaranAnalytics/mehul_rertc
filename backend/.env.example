# ─────────────────────────────────────────────────────────────────────────────
# RE-RTC Dispatch Optimizer — Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# (run from the backend/ directory)
# The app loads this file automatically on startup — no need to \`source .env\`.
# ─────────────────────────────────────────────────────────────────────────────

# Port the FastAPI server listens on (default 8000)
PORT=8000

# Number of uvicorn worker processes (default 2; set to CPU count for prod)
WEB_CONCURRENCY=2

# CORS allowed origins. Use "*" for dev. In production, set to your domain:
# e.g. ALLOWED_ORIGINS=https://rtc.yourdomain.com
ALLOWED_ORIGINS=*

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=re_rtc
POSTGRES_PASSWORD=re_rtc_secret
POSTGRES_DB=re_rtc
POSTGRES_PORT=5432

# SQLAlchemy connection string (used by FastAPI backend)
# Local dev (bundled Postgres): include password if using scram auth
DATABASE_URL=postgresql+psycopg://re_rtc:re_rtc_secret@localhost:5432/re_rtc

# Set false in production (Docker compose sets this automatically)
DEV_RELOAD=false

# When true, FastAPI serves frontend/dist (legacy single-container mode).
# Segregated Docker deployment uses the frontend/nginx container instead.
SERVE_FRONTEND=false

# ── Admin module ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_EXPIRE_HOURS=12
