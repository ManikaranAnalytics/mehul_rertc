# Copy to .env:  cp .env.example .env
# Loaded automatically on startup (python-dotenv).

# Public app port (UI + API on same port, no nginx)
PORT=8012
WEB_CONCURRENCY=2
ALLOWED_ORIGINS=*

# Docker: 0.0.0.0 = reachable on direct IP
BACKEND_BIND=0.0.0.0
# Local uvicorn dev — false; Docker compose sets SERVE_FRONTEND=true
SERVE_FRONTEND=false

# ── PostgreSQL (remote) ──────────────────────────────────────────────────────
POSTGRES_HOST=13.235.110.27
POSTGRES_PORT=5432
POSTGRES_USER=rertc
POSTGRES_PASSWORD=your-password
POSTGRES_DB=rertc
# URL-encode special chars in password (@ → %40)
DATABASE_URL=postgresql+psycopg://rertc:your-url-encoded-password@13.235.110.27:5432/rertc

# ── Optional local Postgres profile (docker compose --profile db only) ───────
# LOCAL_POSTGRES_USER=re_rtc
# LOCAL_POSTGRES_PASSWORD=re_rtc_secret
# LOCAL_POSTGRES_DB=re_rtc
# LOCAL_POSTGRES_PORT=5432

DEV_RELOAD=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_EXPIRE_HOURS=12
